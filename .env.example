FINNHUB_API_KEY=your_finnhub_api_key_here
PORT=3000
# Optional: raises the free Bargo Congress Trades API's fair-use limit from
# 30 to 100 requests/day (no card required). Senate trade data works without
# this, just at the lower keyless limit. https://www.bargo.ai/free-apis/dash
BARGO_API_KEY=

# Optional: enables sign-in and saved dashboards (Supabase auth + Postgres).
# Both values come from your Supabase project (Settings -> API). The anon key
# is meant to be public - row-level security protects the data, not the key.
# Leave blank to run in guest-only mode (default dashboard, no sign-in/saving).
# NEVER put the service_role key here; the browser only ever uses the anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
