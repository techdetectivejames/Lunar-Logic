{
  "name": "fin-app",
  "version": "1.0.0",
  "description": "Finance dashboard with live quotes, stock news + speculation, and congressional trades filtering, powered by Finnhub.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor #0b0e14 --iconBackgroundColorDark #0b0e14 --splashBackgroundColor #0b0e14 --splashBackgroundColorDark #0b0e14",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/push-notifications": "^6.0.5",
    "@revenuecat/purchases-capacitor": "^9.2.2",
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^5.3.0",
    "stripe": "^23.0.0",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2"
  }
}
