FINNHUB_API_KEY=your_finnhub_api_key_here
PORT=3000
# Optional: raises the free Bargo Congress Trades API's fair-use limit from
# 30 to 100 requests/day (no card required). Senate trade data works without
# this, just at the lower keyless limit. https://www.bargo.ai/free-apis/dash
BARGO_API_KEY=

# Optional: enables sign-in and saved dashboards (Supabase auth + Postgres).
# Both values come from your Supabase project (Settings -> API). The anon key
# is meant to be public - row-level security protects the data, not the key.
# Leave blank to run in guest-only mode (default dashboard, no sign-in/saving).
# NEVER put the service_role key here; the browser only ever uses the anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional (Phase 2 paywall). Server-only; enables server-side gating + billing.
# SERVICE ROLE key bypasses RLS - keep it secret, never expose to the browser.
# Without these, premium gating is OFF (the app behaves like Phase 1).
SUPABASE_SERVICE_ROLE_KEY=
# Stripe (https://dashboard.stripe.com/apikeys). Use test keys while developing.
STRIPE_SECRET_KEY=
# Price id of your recurring "Premium" product (Stripe -> Products).
STRIPE_PRICE_ID=
# Webhook signing secret from `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional: absolute base URL for Stripe redirect URLs (defaults to the request
# host). Set this in production, e.g. https://your-app.vercel.app
APP_URL=

# Optional (Phase 3 mobile / RevenueCat). In-app purchases on iOS/Android sync
# to the same entitlements table as Stripe. The iOS/Android keys are PUBLIC SDK
# keys (safe to send to the app via /api/config); the webhook auth is a secret.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
